# Configuración de la conexión a SQL Server
# Copia este archivo como .env y llénalo con tus credenciales reales
# NUNCA subas el archivo .env al control de versiones

DB_SERVER=localhost          # Nombre o IP del servidor SQL Server (ej: MISERV\SQLEXPRESS)
DB_DATABASE=Financiera       # Nombre de la base de datos
DB_USERNAME=sa               # Usuario SQL Login
DB_PASSWORD=TU_PASSWORD_AQUI # Contraseña del usuario
DB_DRIVER=ODBC Driver 17 for SQL Server  # O "SQL Server" si no tienes el driver 17

# CORS: Origins permitidos (frontend URLs separados por coma)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
