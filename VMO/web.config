<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS Configuration para Sistema VMO (Reverse Proxy con ARR + URL Rewrite)
  Reenvia el trafico del sitio IIS al servicio FastAPI / Uvicorn en ejecucion local (puerto 8000).
-->
<configuration>
  <system.webServer>
    <modules>
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="VMO Reverse Proxy" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll" trackAllCaptures="false" />
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <httpErrors existingResponse="PassThrough" />
    <security>
      <requestFiltering allowDoubleEscaping="true">
        <!-- Permite hasta 1 GB para subida de ZIPs y lotes de PDFs de estimaciones -->
        <requestLimits maxAllowedContentLength="1073741824" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
