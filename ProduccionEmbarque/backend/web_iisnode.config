<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS Configuration para SWS Produccion y Embarque usando iisnode nativo
  Requiere modulo iisnode y URL Rewrite instalados en IIS.
-->
<configuration>
  <system.webServer>
    <modules>
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
      <add name="iisnode" path="src/server.js" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <!-- Servir archivos estaticos directamente desde public/ -->
        <rule name="StaticContent" stopProcessing="true">
          <match url="^(assets|css|js|images)/.*" />
          <action type="Rewrite" url="public/{R:0}" />
        </rule>
        <!-- Todas las demas solicitudes van a server.js de Node -->
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True" />
          </conditions>
          <action type="Rewrite" url="src/server.js" />
        </rule>
      </rules>
    </rewrite>
    <iisnode
      nodeProcessCommandLine="&quot;%ProgramFiles%\nodejs\node.exe&quot;"
      maxConcurrentRequestsPerProcess="1024"
      maxNamedPipeConnectionRetry="100"
      namedPipeConnectionRetryDelay="250"
      loggingEnabled="true"
      logDirectory="iisnode"
      debuggingEnabled="false"
    />
    <security>
      <requestFiltering allowDoubleEscaping="true">
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
